generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tasks     Task[]

  @@index([isActive, name, code])
}

model Task {
  id            Int        @id @default(autoincrement())
  title         String
  description   String?
  responsibleId Int
  responsible   TeamMember @relation(fields: [responsibleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status        TaskStatus
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([createdAt, id])
  @@index([responsibleId])
}
