{
  "name": "@gestion-tareas/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "tsx prisma/ensure-database.ts && prisma migrate deploy",
    "db:migrate:dev": "tsx prisma/ensure-database.ts && prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:members": "tsx prisma/seed-members.ts",
    "test": "npm run db:generate && vitest run",
    "test:api": "npm run db:generate && vitest run tests/tasks-api.test.ts",
    "test:lifecycle": "npm run db:generate && vitest run tests/server-lifecycle.test.ts",
    "test:docs": "vitest run tests/openapi.test.ts",
    "docs:validate": "tsx scripts/validate-openapi.ts",
    "test:persistence": "npm run db:generate && vitest run tests/persistence.test.ts",
    "test:members": "npm run db:generate && vitest run tests/team-members.test.ts",
    "test:members:api": "npm run db:generate && vitest run tests/team-members-api.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-types": "12.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
