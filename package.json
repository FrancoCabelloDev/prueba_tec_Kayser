{
  "name": "gestion-tareas-ti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run typecheck && npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run build",
    "start:backend": "npm run start --workspace backend",
    "preview:frontend": "npm run preview --workspace frontend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
