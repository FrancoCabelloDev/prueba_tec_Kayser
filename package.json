{
  "name": "gestion-tareas-ti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run typecheck && npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run docs:validate && npm run build && npm test",
    "start:backend": "npm run start --workspace backend",
    "preview:frontend": "npm run preview --workspace frontend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace backend --",
    "db:status": "npm run db:status --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:seed:members": "npm run db:seed:members --workspace backend",
    "test": "npm run test --workspaces",
    "test:frontend": "npm run test --workspace frontend",
    "test:api": "npm run test:api --workspace backend",
    "test:lifecycle": "npm run test:lifecycle --workspace backend",
    "test:docs": "npm run test:docs --workspace backend",
    "docs:validate": "npm run docs:validate --workspace backend",
    "test:persistence": "npm run test:persistence --workspace backend",
    "test:members": "npm run test:members --workspace backend",
    "test:members:api": "npm run test:members:api --workspace backend"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
