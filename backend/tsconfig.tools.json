{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "prisma.config.ts",
    "vitest.config.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
