generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive, name, code])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  responsible String
  status      TaskStatus
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([createdAt, id])
}
